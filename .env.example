# Supabase - config PUBLIQUE utilisée par la fonction Vercel /api/config.
# SUPABASE_ANON_KEY est protégée par les policies RLS : elle peut être exposée au navigateur.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Clé service_role - SERVEUR UNIQUEMENT (scripts d'admin / migrations).
# Ne jamais l'exposer côté navigateur, ne jamais la mettre dans /api/config.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
